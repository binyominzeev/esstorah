# Copy this file to .env.local and point CONTENT_PATH at the vault content folder.
# Locally this can be the Obsidian vault itself; on the server it should be the
# folder that content-sync/sync_content.py uploads the vault markdown files into.
CONTENT_PATH=/home/user/Documents/MyTorah

# Only needed when the API is on another origin, e.g. local development.
# NEXT_PUBLIC_API_BASE=http://localhost:8001/api
